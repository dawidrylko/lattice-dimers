  "scripts": {
    "start": "cd .. && node benchmarks/runner.js -n 10 -m 7",
    "benchmark": "cd .. && node benchmarks/container.js",
    "benchmark:compare": "cd .. && node benchmarks/full.js compare",
    "benchmark:noise": "cd .. && node benchmarks/container.js --noise",
    "test": "cd .. && node --test js/test/",
    "render": "cd .. && node js/dominoTilingRenderer.js",
    "test:render": "cd .. && node --test js/test/render.test.js",
    "test:benchmarks": "cd .. && node --test benchmarks/test/",
    "test:spec": "cd .. && node --test harness/spec.test.js",
    "test:pari": "cd .. && node --test harness/pari.test.js",
    "test:oeis": "cd .. && node oeis/buildBFiles.js --check && node --test harness/oeis.test.js",
    "test:markdown": "cd .. && node --test harness/markdown.test.js",
    "test:numbers": "cd .. && node --test harness/numbers.test.js",
    "test:metadata": "cd .. && node --test harness/metadata.test.js",
    "test:site": "cd .. && node --test site/test/",
    "site:build": "cd .. && node site/build.js",
    "readme:images": "cd .. && node site/readme-images.js"
  }
